TAVILY_API_KEY=

# Chave da OpenRouter (https://openrouter.ai/keys) — o agente fala com o LLM
# via OpenRouter em vez da API da Anthropic/OpenAI direto.
OPENROUTER_API_KEY=

# Modelo servido pela OpenRouter (ver https://openrouter.ai/models). O
# default é um modelo gratuito — free tier da OpenRouter tem limite de 50
# requisições/dia, e o modelo :free pode ser trocado ou descontinuado pela
# OpenRouter sem aviso; se parar de responder, confira a página do modelo.
OPENROUTER_MODEL=qwen/qwen3-coder:free

# JSON com { portoAlegre: [...], afluentes: [...] } — endpoint /api/guaiba do
# dashboard Next.js. Em produção, aponte para o domínio publicado do dashboard.
GUAIBA_DATA_API_URL=http://localhost:3000/api/guaiba

# Origem do frontend que pode chamar este agente (CORS)
ALLOWED_ORIGIN=http://localhost:3000
